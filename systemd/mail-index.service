[Unit]
Description=Refresh mail index and embeddings from Thunderbird's local mbox files

[Service]
Type=oneshot
WorkingDirectory=%h/projects/thunderbirdmcp
UMask=0077
Environment=TB_EMBED_THREADS=2
TimeoutStartSec=45min
ExecStart=%h/.local/bin/uv run --locked thunderbird-mcp-index
ExecStart=%h/.local/bin/uv run --locked thunderbird-mcp-embed
Nice=10
